# Copia este archivo a .env y completa los valores. No subas .env al repositorio.

# Link de conexión de Neon (Dashboard > Connect > "Connection string", con "Connection pooling" activado).
# Tiene esta forma:
#   postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Para PostgreSQL local: postgres://USUARIO:CLAVE@localhost:5432/telemetria_dev
DATABASE_URL=

# Token Bearer que usa el puente de la Raspberry Pi para escribir lecturas.
# Genera uno con: openssl rand -hex 32
INGEST_TOKEN=

# Puerto HTTP. Render lo asigna solo; en local usa 3000.
PORT=3000

# Opcional. TLS se decide solo a partir del link (Neon: sí; localhost: no).
# Usa true o false únicamente para forzarlo.
# DATABASE_SSL=

# Solo para "npm test". Debe ser una base o rama dedicada: las pruebas vacían la tabla lecturas.
# Ejemplo local: postgres://USUARIO:CLAVE@localhost:5432/telemetria_test
# En Neon: crea una rama (branch) de pruebas y pega aquí su link.
TEST_DATABASE_URL=
